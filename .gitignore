# ─── Compiled output ────────────────────────────────────────────────────────
dist
tmp
out-tsc
*.tsbuildinfo

# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules

# ─── Environment / Secrets ──────────────────────────────────────────────────
# Never commit real env files — use .env.example as the template
.env
.env.local
.env.production
.env.*.local

# ─── Wrangler ───────────────────────────────────────────────────────────────
# Real wrangler configs contain database_id — contributors copy from *.example
# wrangler.toml        ← uncomment if you want to force contributors to copy from .example
# wrangler.cron.toml   ← same
.wrangler/

# ─── Mobile (Expo) ──────────────────────────────────────────────────────────
.expo
.expo-shared

# ─── IDEs ───────────────────────────────────────────────────────────────────
.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ───────────────────────────────────────────────────────────────────
npm-debug.log
yarn-error.log
*.log

# ─── Test / Coverage ────────────────────────────────────────────────────────
/coverage

# ─── Replit (platform-specific, not needed in forks) ────────────────────────
.cache/
.local/
.replitignore
