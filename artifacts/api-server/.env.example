# FeedForge Express API Server — Environment Variables
# Copy this file to .env for local or VPS deployment

PORT=5000

# PostgreSQL connection string (VPS / local dev)
DATABASE_URL=postgresql://feedforge:password@localhost:5432/feedforge

# Bluesky credentials
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# AT Protocol feed generator config
FEEDGEN_PUBLISHER_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
FEEDGEN_HOSTNAME=api.feedforge.yourdomain.com

NODE_ENV=development
